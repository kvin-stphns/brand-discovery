{
  "name": "brand-discovery-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "start:mem": "MONGODB_IN_MEMORY=true node server.js",
    "lint": "eslint .",
    "build": "node -e \"console.log('backend: no build step required for plain JS')\"",
    "test": "jest --runInBand",
    "seed": "node scripts/seed.js",
    "scrape:ff": "node src/crawlee/scrape.js --only=farfetch",
    "scrape:ss": "node src/crawlee/scrape.js --only=ssense",
    "scrape:all": "node src/crawlee/scrape.js",
    "migrate:indexes": "node scripts/migrate-indexes.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "crawlee": "^3.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "p-limit": "^5.0.0",
    "playwright": "^1.46.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "viem": "^2.21.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/test/setupEnv.js"
    ]
  }
}
