{
    "name": "brand-discovery-backend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
      "dev": "nodemon server.js",
      "start": "node server.js",
      "lint": "eslint .",
      "build": "node -e \"console.log('backend: no build step required for plain JS')\"",
      "test": "jest --runInBand",
      "seed": "node scripts/seed.js",
      "scrape:ssense": "node src/scraper/run.js ssense",
      "scrape:farfetch": "node src/scraper/run.js farfetch"
    },
    "dependencies": {
      "cors": "^2.8.5",
      "dotenv": "^16.3.1",
      "express": "^4.18.2",
      "express-rate-limit": "^7.4.0",
      "helmet": "^7.1.0",
      "mongoose": "^8.5.3",
      "morgan": "^1.10.0",
      "swagger-jsdoc": "^6.2.8",
      "swagger-ui-express": "^5.0.1",
      "jsonwebtoken": "^9.0.2",
      "joi": "^17.11.0",
      "cheerio": "^1.0.0"
    },
    "devDependencies": {
      "nodemon": "^3.0.2",
      "eslint": "^8.57.0",
      "jest": "^29.7.0",
      "supertest": "^7.0.0",
      "mongodb-memory-server": "^10.1.4"
    },
    "jest": {
      "testEnvironment": "node",
      "testMatch": ["**/__tests__/**/*.test.js"],
      "setupFiles": ["<rootDir>/test/setupEnv.js"]
    }
  }
